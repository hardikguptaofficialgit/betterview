{
  "name": "intelligent-ui-ext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:popup": "vite build -c vite.config.ts",
    "build:content": "vite build -c vite.content.config.ts",
    "build:background": "vite build -c vite.background.config.ts",
    "build": "npm run typecheck && npm run build:popup && npm run build:content && npm run build:background && node scripts/check-ascii.mjs && node scripts/check-content.mjs",
    "package": "node scripts/package.mjs",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1",
    "fixture": "vite build -c vite.fixture.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "simple-icons": "16.38.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "chart.js": "^4.6.1",
    "mermaid": "^12.3.0"
  }
}
