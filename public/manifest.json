{
  "manifest_version": 3,
  "name": "BetterView AI",
  "short_name": "BetterView",
  "version": "0.1.0",
  "description": "Render compact interactive visuals natively inside Gemini, Grok, ChatGPT, and Claude chats.",
  "homepage_url": "https://github.com/hardikguptaofficialgit/betterview",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "brand/icon-dark-16.png",
    "32": "brand/icon-dark-32.png",
    "48": "brand/icon-dark-48.png",
    "128": "brand/icon-dark-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "brand/icon-dark-16.png",
      "32": "brand/icon-dark-32.png",
      "48": "brand/icon-dark-48.png",
      "128": "brand/icon-dark-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "assets/*",
        "brand/*"
      ],
      "matches": [
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ]
    }
  ]
}
